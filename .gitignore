# Llega con la copia de workspace/ en el bootstrap, ANTES del primer commit (blueprint §10).
# blueprints/ NO se ignora: el bundle del blueprint se versiona con el código.

# Secretos locales. .env.example sí se versiona.
.env
.env.*
!.env.example

# Temporales de scripts y verificaciones
.tmp/

