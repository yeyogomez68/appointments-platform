# Plantilla de variables de entorno (blueprint §10). Se versiona; .env NO.
# node scripts/init-env.mjs copia este archivo a .env y genera los secretos locales vacíos marcados (*).

# --- Base de datos (paso 1) ---
DB_URL=jdbc:postgresql://localhost:5432/citas
# (*) superusuario del contenedor postgres; solo lo usa docker compose
DB_SUPERUSER_PASSWORD=
# (*) app_owner: Flyway
DB_OWNER_PASSWORD=
# (*) app_runtime: la API
DB_RUNTIME_PASSWORD=

# --- Tokens (paso 7) ---
# (*) 64 caracteres hexadecimales (32 bytes) para firmar JWT HS256
JWT_SECRET=
COOKIE_SECURE=false

# --- Datos de demostración (paso 9; el perfil dev siembra siempre) ---
APP_SEED_DEMO=false
# (*) contraseña de owner@demo.local y recepcion@demo.local
DEV_SEED_PASSWORD=

# --- Web / CORS (paso 10) y enlaces de correo (paso 11) ---
APP_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Correo (paso 11). Local: Mailpit. Producción: Brevo smtp-relay.brevo.com:587 con STARTTLS ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-responder@plataforma-citas.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# --- Captcha (pasos 10 y 12). El perfil dev usa el verificador falso; staging/producción: turnstile ---
CAPTCHA_PROVIDER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Registro y textos legales (paso 12) ---
SIGNUP_LIMIT_PER_HOUR=5
LEGAL_TERMS_VERSION=borrador-2026-10
LEGAL_DPA_VERSION=borrador-2026-10

# --- Observabilidad (opcional siempre) ---
SENTRY_DSN=
APP_ENV=local

# --- Solo staging/producción: deploy/compose.prod.yml (paso 18) ---
API_IMAGE=
WEB_IMAGE=
SITE_ADDRESS=
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
BASIC_AUTH_USER=
BASIC_AUTH_HASH=
